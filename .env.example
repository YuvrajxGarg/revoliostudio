# muapi.ai — also powers Autopilot's planning step (Gemini 2.5 Flash via
# muapi's unified LLM endpoint, see src/lib/gemini.ts) — no separate key needed.
MUAPI_API_KEY=your_muapi_api_key_here
# Optional overrides — only needed if muapi renames these endpoints:
# MUAPI_BASE_URL=https://api.muapi.ai/api/v1
# MUAPI_MESHY_IMAGE_TO_3D_ENDPOINT=meshy-image-to-3d
# MUAPI_MESHY_TEXT_TO_3D_ENDPOINT=meshy-text-to-3d

# Photoroom (Remove Background API, Basic plan) — powers the "Remove
# Background" tool instead of muapi's own. Get a key at photoroom.com/api.
PHOTOROOM_API_KEY=your_photoroom_api_key_here

# Pexels (free stock photos, no attribution required) — powers the admin
# "Import from stock" flow for seeding the Reference Library's curated
# Style/Character/Location/Element picks. Get a free key at pexels.com/api.
# Optional: only the admin Reference Library's stock-import search needs it.
PEXELS_API_KEY=your_pexels_api_key_here

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
