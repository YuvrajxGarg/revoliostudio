.vercel

# secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# deps
node_modules

# build output
.next
out
build
dist

# misc
.DS_Store
# macOS AppleDouble sidecars — created whenever the repo is edited from macOS
# on a non-HFS volume (exFAT/NTFS). Junk metadata, never source.
._*
*.log
npm-debug.log*
.turbo

# large media assets — not source, keep out of git history
/Effect previews/
/Higgsfield Presets/
tsconfig.tsbuildinfo
